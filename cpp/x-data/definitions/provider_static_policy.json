{
  "schema": 1,
  "wire_type_materializers": {
    "AccountID": "account_id",
    "Amount": "amount",
    "Blob": "blob",
    "Currency": "currency",
    "Hash128": "hash128",
    "Hash160": "hash160",
    "Hash192": "hash192",
    "Hash256": "hash256",
    "Issue": "issue",
    "Number": "number",
    "PathSet": "path_set",
    "STArray": "st_array",
    "STObject": "st_object",
    "UInt16": "uint16",
    "UInt32": "uint32",
    "UInt64": "uint64",
    "UInt8": "uint8",
    "Vector256": "vector256",
    "XChainBridge": "xchain_bridge"
  },
  "descriptor_overrides": {
    "LedgerEntryType": "ledger_entry_type",
    "TransactionResult": "transaction_result",
    "TransactionType": "transaction_type"
  },
  "object_specializations": {
    "families": [
      {
        "name": "Transaction",
        "discriminator": "TransactionType",
        "type_table": "TRANSACTION_TYPES",
        "format_table": "TRANSACTION_FORMATS",
        "leaves": ["Payment"],
        "defaults": {
          "Flags": "uint32_zero"
        }
      },
      {
        "name": "LedgerEntry",
        "discriminator": "LedgerEntryType",
        "type_table": "LEDGER_ENTRY_TYPES",
        "format_table": "LEDGER_ENTRY_FORMATS",
        "leaves": ["AccountRoot", "URIToken", "Hook", "HookDefinition"],
        "leaf_names": {
          "Hook": "HookLedger"
        },
        "leaf_bindings": {
          "Hook": ["LedgerEntryType", "Hooks"],
          "HookDefinition": ["LedgerEntryType", "HookHash"]
        }
      }
    ],
    "refinements": {
      "AccountRoot": {
        "Balance": "native_amount"
      }
    }
  }
}
